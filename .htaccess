# Use the site's custom 404 page for any real 404 (safe to leave permanently)
ErrorDocument 404 /404.html

# --- MAINTENANCE MODE: force homepage to serve maintenance.html instead of index.html ---
# Active now. Uses a 503 status (not 404) so search engines know this is temporary
# and don't drop the site from their index while it's down.
# To revert: comment out (or delete) these three lines, then re-upload.
# RewriteEngine On
# ErrorDocument 503 /404.html
# RewriteRule ^$ - [R=404,L]
